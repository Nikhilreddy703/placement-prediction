# PlacementOS Enterprise Environment Configuration

# Backend Configuration
PORT=8000
DEBUG=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placementos
REDIS_URL=redis://localhost:6379/0

# ML Engine
DEFAULT_THRESHOLD=0.69
CHAMPION_MODEL=Logistic Regression

# Optional LLM Integration (Leave blank for verified offline rule-based heuristic mode)
GEMINI_API_KEY=
GROK_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy Streamlit (Optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
